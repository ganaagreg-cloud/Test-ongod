# Mobile app settings. Copy to apps/mobile/.env (Expo reads it from this folder, not the repo root).
# Everything EXPO_PUBLIC_* is baked into the app bundle: never put a secret here.
# For preview and production builds set the same names as EAS environment variables
# (eas env:create), see docs/runbooks/MOBILE_BUILD.md.

# API base address, no trailing slash and no /v1.
#   Android emulator -> the computer:  http://10.0.2.2:3000
#   Real phone on the same Wi-Fi:      http://<computer LAN IP>:3000
#   iOS simulator / web preview:        http://localhost:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Portal base address, no trailing slash: the Welcome terms line and the Profile links open
# {PORTAL_URL}/terms and {PORTAL_URL}/privacy. Empty = those links are hidden. The final domain is
# still open (docs/open-questions.md #9); the stores need a reachable privacy page before submission.
#   Local portal:  http://<computer LAN IP>:3000
EXPO_PUBLIC_PORTAL_URL=

# Crash reports (optional, see ADR-0016). Empty = Sentry stays off.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development

# Where the "update required" screen sends people (store pages). Empty = no button.
EXPO_PUBLIC_IOS_STORE_URL=
EXPO_PUBLIC_ANDROID_STORE_URL=

# Google sign-in (only used when the API reports SOCIAL_LOGIN=true). Client IDs are public.
# Web client ID: the one the API checks as audience (GOOGLE_CLIENT_IDS); needed on both platforms.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Build-time only (read by app.config.ts, not bundled into the app):
# Reversed iOS client ID, e.g. com.googleusercontent.apps.123-abc
GOOGLE_IOS_URL_SCHEME=
# Source-map upload to Sentry during builds; SENTRY_AUTH_TOKEN goes in EAS secrets, never here.
SENTRY_ORG=
SENTRY_PROJECT=
