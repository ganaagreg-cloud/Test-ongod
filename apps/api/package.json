{
  "name": "@ongod/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "ops:bootstrap": "tsx scripts/ops-bootstrap.ts",
    "dev:setup": "tsx --env-file-if-exists=../../.env scripts/dev-setup.ts",
    "dev:approve": "tsx --env-file-if-exists=../../.env scripts/dev-approve.ts",
    "dev:totp": "tsx --env-file-if-exists=../../.env scripts/dev-totp.ts",
    "bunny:reference": "tsx scripts/fetch-bunny-reference.ts",
    "bunny:smoke": "tsx --env-file-if-exists=../../.env scripts/bunny-smoke.ts",
    "test": "tsx scripts/fetch-bunny-reference.ts --if-missing && vitest run",
    "test:unit": "tsx scripts/fetch-bunny-reference.ts --if-missing && vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@ongod/shared": "workspace:*",
    "@ongod/tokens": "workspace:*",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "^11.5.0",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.2.0",
    "jose": "^6.2.12",
    "music-metadata": "^12.0.0",
    "nodemailer": "^10.0.16",
    "otplib": "^13.5.0",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@types/nodemailer": "^8.0.2",
    "prisma": "7.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
