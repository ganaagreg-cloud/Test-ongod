# Copy to .env and fill in. Never commit real values.

# --- Server ---
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# --- Database (MySQL 8) ---
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/ongod

# --- Auth ---
JWT_ACCESS_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
SOCIAL_LOGIN=false
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# --- Bunny (all Bunny settings live here so the account can be swapped) ---
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_REGION=
BUNNY_CDN_HOSTNAME=
BUNNY_CDN_TOKEN_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Push ---
EXPO_ACCESS_TOKEN=

# --- Bank transfer details shown in the portal ---
BANK_NAME=
BANK_ACCOUNT=
BANK_ACCOUNT_HOLDER=
