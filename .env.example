# Copy to .env and fill in. Never commit real values.
# The API validates these on start and exits if a required value is missing or invalid.

# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info
# Set to true behind a reverse proxy (Plesk/nginx) so client IPs and rate limits are correct.
TRUST_PROXY=false
# Comma-separated browser origins allowed to call /v1 cross-origin (dev servers). Empty = same origin only.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# Serve apps/portal/dist at / and apps/admin/dist at /admin from this process.
SERVE_STATIC=false

# --- Local docker-compose (MySQL + Mailpit) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=ongod
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

# --- Database (MySQL 8) ---
# allowPublicKeyRetrieval is needed for MySQL 8 auth without TLS (local dev).
DATABASE_URL=mysql://ongod:change-me@localhost:3306/ongod?allowPublicKeyRetrieval=true
# Used only by tests. Must point at a database whose name ends in _test; it is wiped.
TEST_DATABASE_URL=mysql://ongod:change-me@localhost:3306/ongod_test?allowPublicKeyRetrieval=true

# --- Jobs / cron ---
# In-process job worker. Disable to run jobs only from /v1/cron/tick.
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_MS=2000
# Secret for POST /v1/cron/tick (header X-Cron-Secret). At least 32 characters.
CRON_SECRET=replace-with-a-long-random-string-32+

# --- Seed (pnpm --filter @ongod/api db:seed) ---
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-owner
SEED_USER_PASSWORD=change-me-user

# --- Auth ---
# HS256 signing key for access tokens (jose). At least 32 characters. Also keys the email-code HMAC.
JWT_ACCESS_SECRET=replace-with-a-long-random-string-32+
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Login, register and code endpoints: max attempts per window, counted per IP and per identifier.
AUTH_RATE_LIMIT_IP_MAX=30
AUTH_RATE_LIMIT_IDENTIFIER_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
SOCIAL_LOGIN=false
# Required when SOCIAL_LOGIN=true. Comma-separated Google OAuth client IDs (web, iOS, Android).
GOOGLE_CLIENT_IDS=
# Required when SOCIAL_LOGIN=true. Comma-separated: the iOS bundle ID and the web Services ID.
APPLE_CLIENT_IDS=

# --- Bunny (all Bunny settings live here so the account can be swapped) ---
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
# Storage region prefix: empty or de = Frankfurt; uk, ny, la, sg, se, br, jh or syd.
BUNNY_STORAGE_REGION=
# Pull zone hostname only, no https://, e.g. ongod-dev.b-cdn.net
BUNNY_PULL_ZONE_HOST=
# Token Authentication key of the pull zone (IP validation must be OFF, see ADR-0020).
BUNNY_CDN_TOKEN_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# --- Email (Mailpit locally; a real SMTP provider in production) ---
SMTP_HOST=localhost
SMTP_PORT=1025
# true = TLS from the start (port 465). false = plain or STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Онгод <no-reply@example.com>"

# --- Push ---
EXPO_ACCESS_TOKEN=

# --- Monitoring ---
# Rotated log file (daily or when it reaches LOG_FILE_MAX_SIZE; keeps the newest LOG_FILE_COUNT).
# Empty = stdout only. Logs always go to stdout too.
LOG_FILE=
LOG_FILE_MAX_SIZE=20m
LOG_FILE_COUNT=14
# Comma-separated addresses that get an email for server errors (5xx) and failed jobs.
# Empty = no alert emails. The same error is emailed at most once per ALERT_THROTTLE_MINUTES.
ALERT_EMAILS=
ALERT_THROTTLE_MINUTES=60

# --- Error tracking (optional, Sentry) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Bank transfer details shown in the portal ---
BANK_NAME=
BANK_ACCOUNT=
BANK_ACCOUNT_HOLDER=
